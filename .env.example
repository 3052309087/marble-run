# Copy to .env and fill secrets, or run scripts/setup-docker.ps1.
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_PORT=5173
API_PORT=3000
DB_PORT=5432

# Docker Official Images via the Amazon ECR Public mirror.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.28-alpine
